# Qwen2.5-specific checkpoint converter (fused qkv_proj/gate_up_proj -> HF
# format) — not general-purpose, kept local only. See README's Model section
# for what conversion needs to do if you're using a different architecture.
scripts/convert_to_hf.py

# Docker image is untested and doesn't build; kept local only, not
# distributed or maintained as part of the repo.
docker/

# Publish the two user guides. Other local write-ups, including
# GPQA's full method, per-seed tables and answer-position diagnostics, stay local.
/docs/*
!/docs/reproduction.md
!/docs/model_evaluation.md

# Editors / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Coverage / test
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Wandb
wandb/

# Results: publish only the reviewed evaluation summaries and figures below.
# Training runs, model responses, benchmark text and arbitrary new outputs stay local.
/results/**
!/results/README.md
!/results/passk/
!/results/passk/1.5B/
!/results/passk/7B/
!/results/passk/1.5B/*_summary.json
!/results/passk/7B/*_summary.json
!/results/passk/1.5B/*_passk.png
!/results/passk/7B/*_passk.png
!/results/mmlu/
!/results/mmlu/scores.csv
!/results/ethics/
!/results/ethics/summary.csv
!/results/ethics/rest_summary.csv
!/results/weights/
!/results/weights/figures/
!/results/weights/figures/weight_change_*.png

# Transient model copies created by the external maths evaluator.
**/model_shards.*/
.scratch/

# Historical grader-audit scripts remain local.
scripts/grader_audit/
