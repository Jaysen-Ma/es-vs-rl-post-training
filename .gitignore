# distributed or maintained as part of the repo.
docker/

# Long-form write-ups kept local. GPQA's full method, per-seed tables and
# answer-position diagnostics live in docs/gpqa.md; the README carries the
# summary and the conclusion, which is all a reader of this repo needs.
docs/

